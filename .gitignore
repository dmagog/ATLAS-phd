.DS_Store
*.log
__pycache__/
.pytest_cache/
.mypy_cache/
.venv/
.env
.claude/

# Eval runtime artifacts — keep folder structure (.gitkeep) and final reports,
# not the per-run dumps.
eval/results/*
!eval/results/.gitkeep
!eval/results/*.md
!eval/results/*.json

# Materials from colleagues — not version-controlled (binary, large, copyrighted)
Кандидатский экзамен/

# Corpus side-effect: ingested PDFs/DOCX are saved to corpus/ by pipeline.
# We keep JSONL + program.md tracked, but exclude binary uploads (large,
# copyrighted, retrievable from original source folder).
corpus/*.pdf
corpus/*.docx
corpus/atlas_test.txt
