# Скопируй в .env и ОБЯЗАТЕЛЬНО замени все значения ниже.
# Приложение упадёт на старте, если оставить placeholder'ы (см. atlas.core.config).

# ── App ──────────────────────────────────────────────────────────────────────
# В production app_env=production включает строгие проверки длины секретов.
APP_ENV=development

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
# Получи ключ на https://openrouter.ai/keys
LLM_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
LLM_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free

# ── Database ─────────────────────────────────────────────────────────────────
# Сгенерируй сильный пароль: `python -c "import secrets; print(secrets.token_urlsafe(24))"`
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ── Auth ─────────────────────────────────────────────────────────────────────
# Сгенерируй: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Минимум 32 символа в production (валидируется на старте).
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Email и пароль для seed первого super-admin при `seed_admin` на старте.
# Минимум 12 символов в production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ── Optional ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
